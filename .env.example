# Use the Neon development branch locally. Replace all placeholders.
DATABASE_URL=postgresql://USER:PASSWORD@ep-DEVELOPMENT_ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-DEVELOPMENT_ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require
NEON_DEVELOPMENT_ENDPOINT_ID=ep-DEVELOPMENT_ENDPOINT
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique random secret of at least 32 characters for each environment.
BETTER_AUTH_SECRET=replace-me

# Set the final HTTPS origin when the public domain is ready; leave blank locally.
NEXT_PUBLIC_SITE_URL=https://archimartng-v1.vercel.app

# Cloudflare R2 image storage. Use a separate development bucket and scoped key.
# Set only DEV values locally; set PLAN_IMAGE_ENV=production only in production.
PLAN_IMAGE_ENV=development
PLAN_IMAGE_DEV_ENDPOINT=https://development-s3-api-endpoint.example
PLAN_IMAGE_DEV_BUCKET=archimart-development-images
PLAN_IMAGE_DEV_PUBLIC_BASE_URL=https://development-images.example.com
PLAN_IMAGE_DEV_REGION=auto
PLAN_IMAGE_DEV_ACCESS_KEY_ID=replace-me
PLAN_IMAGE_DEV_SECRET_ACCESS_KEY=replace-me
# Set PROD values only in the production deployment environment.
PLAN_IMAGE_PROD_ENDPOINT=https://production-s3-api-endpoint.example
PLAN_IMAGE_PROD_BUCKET=archimart-production-images
PLAN_IMAGE_PROD_PUBLIC_BASE_URL=https://images.example.com
PLAN_IMAGE_PROD_REGION=auto
PLAN_IMAGE_PROD_ACCESS_KEY_ID=replace-me
PLAN_IMAGE_PROD_SECRET_ACCESS_KEY=replace-me
